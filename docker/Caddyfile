# FrankenPHP for the Railway web service. Railway terminates TLS at its edge
# and forwards plain HTTP to $PORT, so Caddy's automatic HTTPS and admin API
# stay off. Security headers come from the SecurityHeaders middleware.
{
	admin off
	auto_https off
	frankenphp
}

:{$PORT:8080} {
	root * /var/www/html/public
	encode zstd gzip
	header -Server
	php_server
}
